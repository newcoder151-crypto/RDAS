# Copy to .env (or just `export` these) before running stream_pipeline.py.
# All are optional — the script has hardcoded fallback defaults if unset,
# but you MUST set at least RDAS_INPUT_URL to your real camera.

RDAS_INPUT_URL=rtsp://admin:yourpassword@192.168.1.50:554/Streaming/Channels/101
RDAS_OUTPUT_URL=rtsp://localhost:8554/rdas
RDAS_YOLO_WEIGHTS=./yolo26m.pt
RDAS_FACE_TASK=./face_landmarker.task
RDAS_WS_HOST=0.0.0.0
RDAS_WS_PORT=8765
