# Copy this to .env and adjust if the backend isn't on localhost.

# WebSocket URL for structured alarms/telemetry (AlarmBroadcastServer in stream_pipeline.py)
VITE_RDAS_WS_URL=ws://localhost:8765

# HLS URL for the annotated video stream, served by MediaMTX
VITE_RDAS_HLS_URL=http://localhost:8888/rdas/index.m3u8
